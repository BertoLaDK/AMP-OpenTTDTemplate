Meta.DisplayName=OpenTTD (Standalone)
Meta.Description=OpenTTD Dedicated Server - official standalone build, no Steam
Meta.OS=Linux
Meta.Arch=x86_64
Meta.Author=Custom
Meta.URL=https://www.openttd.org/
Meta.DisplayImageSource=https://www.openttd.org/
Meta.EndpointURIFormat=
Meta.ConfigRoot=ottdds.kvp
Meta.MinAMPVersion=2.5.0.14
Meta.ContainerPolicy=RecommendedOnLinux
Meta.ExtraContainerPackages=["libgomp1"]
Meta.ConfigReleaseState=NotSpecified
Meta.NoCommercialUsage=False
Meta.AppConfigId=5e9d8c1a-3f47-4b62-9a15-c8e2f0d7b431
Meta.ConfigVersion=1
Meta.AppIsMultiIPAware=True
App.DisplayName=OpenTTD Standalone
App.RootDir=./ottdds/
App.BaseDirectory=./ottdds/
App.ExecutableLinux=openttd
App.WorkingDir=.
App.CommandLineArgs=-D {{$ApplicationIPBinding}}:{{$ServerPort}} -c config/openttd.cfg {{$FormattedArgs}}
App.AppSettings={}
App.EnvironmentVariables={}
App.CommandLineParameterFormat=-{0} "{1}"
App.CommandLineParameterDelimiter=
App.ExitMethod=String
App.ExitTimeout=30
App.ExitString=quit
App.HasWriteableConsole=True
App.HasReadableConsole=True
App.SupportsLiveSettingsChanges=False
App.ApplicationIPBinding=0.0.0.0
App.Ports=@IncludeJson[ottddsports.json]
App.PrimaryApplicationPortRef=ServerPort
App.MaxUsers=25
App.AdminMethod=STDIO
App.RapidStartup=False
App.ApplicationReadyMode=RegexMatch
Console.AppReadyRegex=^(?:\[[\d-]+ [\d:]+\] )?dbg: \[net(?::\d+)?\] Listening on [\d.:]+ \(IPv4\)$
App.UpdateSources=@IncludeJson[ottddsupdates.json]