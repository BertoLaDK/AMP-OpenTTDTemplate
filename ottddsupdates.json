[
    {
        "UpdateStageName": "OpenTTD Download",
        "UpdateSourcePlatform": "Linux",
        "UpdateSource": "FetchURL",
        "UpdateSourceData": "https://cdn.openttd.org/openttd-releases/15.3/openttd-15.3-linux-amd64.tar.gz",
        "UpdateSourceTarget": "{{$FullBaseDir}}",
        "OverwriteExistingFiles": true,
        "SkipOnFailure": false
    },
    {
        "UpdateStageName": "Flatten Archive",
        "UpdateSourcePlatform": "Linux",
        "UpdateSource": "Executable",
        "UpdateSourceData": "bash",
        "UpdateSourceArgs": "-c \"cd {{$FullBaseDir}} && mv openttd-*-linux-amd64/* . && rm -rf openttd-*-linux-amd64 && chmod +x openttd\"",
        "SkipOnFailure": false
    },
    {
        "UpdateStageName": "Create Config Directory",
        "UpdateSourcePlatform": "All",
        "UpdateSource": "CreateDirectory",
        "UpdateSourceArgs": "{{$FullBaseDir}}config",
        "OverwriteExistingFiles": false,
        "SkipOnFailure": false
    },
    {
        "UpdateStageName": "Openttd.cfg Download",
        "UpdateSourcePlatform": "All",
        "UpdateSource": "FetchURL",
        "UpdateSourceData": "https://cdn-repo.c7rs.com/AMPTemplates/openttdopenttd.cfg",
        "UpdateSourceArgs": "openttd.cfg",
        "UpdateSourceTarget": "{{$FullBaseDir}}config",
        "OverwriteExistingFiles": false,
        "SkipOnFailure": false
    },
    {
        "UpdateStageName": "Private.cfg Download",
        "UpdateSourcePlatform": "All",
        "UpdateSource": "FetchURL",
        "UpdateSourceData": "https://cdn-repo.c7rs.com/AMPTemplates/openttdprivate.cfg",
        "UpdateSourceArgs": "private.cfg",
        "UpdateSourceTarget": "{{$FullBaseDir}}config",
        "OverwriteExistingFiles": false,
        "SkipOnFailure": false
    },
    {
        "UpdateStageName": "Secrets.cfg Download",
        "UpdateSourcePlatform": "All",
        "UpdateSource": "FetchURL",
        "UpdateSourceData": "https://cdn-repo.c7rs.com/AMPTemplates/openttdsecrets.cfg",
        "UpdateSourceArgs": "secrets.cfg",
        "UpdateSourceTarget": "{{$FullBaseDir}}config",
        "OverwriteExistingFiles": false,
        "SkipOnFailure": false
    }
]