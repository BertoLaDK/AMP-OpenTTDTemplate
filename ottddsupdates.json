[
        {
        "UpdateStageName": "OpenTTD Download",
        "UpdateSourcePlatform": "Linux",
        "UpdateSource": "FetchURL",
        "UpdateSourceData": "https://cdn.openttd.org/openttd-releases/15.3/openttd-15.3-linux-generic-amd64.tar.xz",
        "UpdateSourceTarget": "{{$FullBaseDir}}",
        "OverwriteExistingFiles": true,
        "SkipOnFailure": false
    },
    {
        "UpdateStageName": "Extract Archive",
        "UpdateSourcePlatform": "Linux",
        "UpdateSource": "Executable",
        "UpdateSourceData": "bash",
        "UpdateSourceArgs": "-c \"cd {{$FullBaseDir}} && tar -xvJf openttd-15.3-linux-generic-amd64.tar.xz --strip-components=1 && rm -f openttd-15.3-linux-generic-amd64.tar.xz && chmod +x openttd\"",
        "SkipOnFailure": false
    },
    {
        "UpdateStageName": "OpenGFX Download",
        "UpdateSourcePlatform": "All",
        "UpdateSource": "FetchURL",
        "UpdateSourceData": "https://cdn.openttd.org/opengfx-releases/8.0/opengfx-8.0-all.zip",
        "UpdateSourceTarget": "{{$FullBaseDir}}baseset",
        "OverwriteExistingFiles": false,
        "SkipOnFailure": false
    },
    {
        "UpdateStageName": "OpenGFX Extract",
        "UpdateSourcePlatform": "Linux",
        "UpdateSource": "Executable",
        "UpdateSourceData": "bash",
        "UpdateSourceArgs": "-c \"cd {{$FullBaseDir}}baseset && unzip -q -o opengfx-8.0-all.zip && rm -f opengfx-8.0-all.zip\"",
        "SkipOnFailure": false
    },
    {
        "UpdateStageName": "Create Config Directory",
        "UpdateSourcePlatform": "All",
        "UpdateSource": "CreateDirectory",
        "UpdateSourceArgs": "{{$FullBaseDir}}config",
        "OverwriteExistingFiles": false,
        "SkipOnFailure": false
    },
    {
        "UpdateStageName": "Openttd.cfg Download",
        "UpdateSourcePlatform": "All",
